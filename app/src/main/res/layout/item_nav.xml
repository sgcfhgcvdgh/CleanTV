<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="44dp"
    android:layout_marginBottom="6dp" android:background="@drawable/bg_nav_item"
    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="13dp" android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/navIcon"
        android:layout_width="22dp" android:layout_height="22dp"
        android:duplicateParentState="true" android:importantForAccessibility="no"
        app:tint="@color/nav_text" />

    <TextView
        android:id="@+id/navLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="18dp" android:alpha="0"
        android:duplicateParentState="true" android:fontFamily="sans-serif-medium"
        android:singleLine="true" android:textColor="@color/nav_text" android:textSize="16sp" />
</LinearLayout>
