<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="6dp" android:background="@drawable/bg_tile"
    android:clickable="true" android:focusable="true"
    android:orientation="vertical" android:padding="6dp">

    <ImageView
        android:id="@+id/poster"
        android:layout_width="match_parent" android:layout_height="150dp"
        android:importantForAccessibility="no" android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:ellipsize="end" android:gravity="center"
        android:lines="2" android:textColor="@color/text" android:textSize="13sp" />
</LinearLayout>
