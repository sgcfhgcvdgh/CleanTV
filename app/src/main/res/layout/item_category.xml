<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="44dp"
    android:layout_marginBottom="2dp" android:background="@drawable/bg_item"
    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:ellipsize="end" android:singleLine="true"
        android:duplicateParentState="true" android:textColor="@color/nav_text" android:textSize="16sp" />

    <TextView
        android:id="@+id/count"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:duplicateParentState="true" android:textColor="@color/nav_text" android:textSize="13sp" />
</LinearLayout>
