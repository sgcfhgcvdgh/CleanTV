<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="72dp"
    android:layout_marginBottom="6dp" android:background="@drawable/bg_tile"
    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="18dp">

    <FrameLayout
        android:layout_width="84dp" android:layout_height="48dp"
        android:background="@drawable/bg_logo">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" android:padding="5dp" android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="230dp" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:fontFamily="sans-serif-medium" android:singleLine="true"
            android:textColor="@color/text" android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:orientation="horizontal">

            <TextView
                android:id="@+id/fav"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="6dp" android:text="★"
                android:textColor="@color/gold" android:textSize="12sp" android:visibility="gone" />

            <TextView
                android:id="@+id/badges"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:singleLine="true" android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="16dp" android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">

            <TextView
                android:id="@+id/nowTime"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" android:textColor="@color/muted" android:textSize="13sp" />

            <TextView
                android:id="@+id/nowTitle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:ellipsize="end" android:singleLine="true"
                android:textColor="@color/text" android:textSize="15sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/nowProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp"
            android:layout_marginTop="5dp" android:max="1000"
            android:progressDrawable="@drawable/progress_card" />

        <TextView
            android:id="@+id/next"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:ellipsize="end" android:singleLine="true"
            android:textColor="@color/faint" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
