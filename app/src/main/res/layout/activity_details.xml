<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:importantForAccessibility="no" android:scaleType="centerCrop" />

    <View
        android:id="@+id/scrimLeft"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/scrim_left" />

    <View
        android:layout_width="match_parent" android:layout_height="300dp"
        android:layout_gravity="bottom" android:background="@drawable/scrim_bottom" />

    <View
        android:id="@+id/shade"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:background="@color/bg" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false" android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:clipChildren="false" android:clipToPadding="false"
            android:orientation="vertical" android:paddingBottom="48dp">

            <LinearLayout
                android:id="@+id/top"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clipChildren="false" android:clipToPadding="false"
                android:gravity="bottom" android:orientation="vertical"
                android:paddingStart="@dimen/keyline" android:paddingEnd="360dp"
                android:paddingBottom="30dp">

                <TextView
                    android:id="@+id/kicker"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="0.18"
                    android:textAllCaps="true" android:textColor="@color/accent" android:textSize="12sp" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2"
                    android:fontFamily="sans-serif-black" android:lineSpacingMultiplier="0.92"
                    android:textColor="@color/text" android:textSize="42sp" />

                <LinearLayout
                    android:id="@+id/metaRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/match"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/fresh" android:textSize="14sp" android:visibility="gone" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:ellipsize="end" android:singleLine="true"
                        android:textColor="@color/muted" android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scores"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="horizontal" />

                <TextView
                    android:id="@+id/plot"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:ellipsize="end" android:maxLines="4"
                    android:lineSpacingMultiplier="1.18" android:textColor="#E6F5F5F1" android:textSize="15sp" />

                <TextView
                    android:id="@+id/credits"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="2"
                    android:lineSpacingMultiplier="1.15" android:textColor="@color/muted" android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/buttons"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:clipChildren="false"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/play" style="@style/HeroButton">
                        <ImageView style="@style/HeroButtonIcon" android:src="@drawable/ic_play" />
                        <TextView android:id="@+id/playText" style="@style/HeroButtonText" android:text="Play" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/episodes" style="@style/HeroButton" android:visibility="gone">
                        <ImageView style="@style/HeroButtonIcon" android:src="@drawable/ic_episodes" />
                        <TextView style="@style/HeroButtonText" android:text="Episodes" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/myList" style="@style/HeroButton">
                        <ImageView android:id="@+id/myListIcon" style="@style/HeroButtonIcon" android:src="@drawable/ic_add" />
                        <TextView style="@style/HeroButtonText" android:text="My List" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/versions" style="@style/HeroButton" android:visibility="gone">
                        <ImageView style="@style/HeroButtonIcon" android:src="@drawable/ic_layers" />
                        <TextView android:id="@+id/versionsText" style="@style/HeroButtonText" android:text="Versions" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/RowTitle"
                android:layout_marginStart="@dimen/keyline" android:layout_marginTop="8dp"
                android:text="What the critics say" />

            <TextView
                android:id="@+id/criticsStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:paddingStart="@dimen/keyline" android:paddingEnd="300dp"
                android:text="Looking up reviews…"
                android:textColor="@color/muted" android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reviews"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clipChildren="false" android:clipToPadding="false"
                android:paddingStart="@dimen/keyline" android:paddingTop="14dp"
                android:paddingEnd="64dp" android:paddingBottom="18dp" />

            <TextView
                android:id="@+id/moreTitle"
                style="@style/RowTitle"
                android:layout_marginStart="@dimen/keyline" android:layout_marginTop="10dp"
                android:text="More like this" android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/more"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clipChildren="false" android:clipToPadding="false"
                android:paddingStart="@dimen/keyline" android:paddingTop="12dp"
                android:paddingEnd="64dp" android:paddingBottom="16dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
