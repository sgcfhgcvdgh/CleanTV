<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="132dp"
    android:layout_margin="6dp" android:background="@drawable/bg_tile"
    android:clickable="true" android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_horizontal" android:orientation="vertical" android:padding="8dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:importantForAccessibility="no" android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:ellipsize="end" android:gravity="center"
            android:maxLines="2" android:textColor="@color/text" android:textSize="14sp" />

        <TextView
            android:id="@+id/badges"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:gravity="center" android:singleLine="true"
            android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/fav"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="6dp"
        android:text="★" android:textColor="#FFC94D" android:textSize="16sp" android:visibility="gone" />
</FrameLayout>
