<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:layout_marginBottom="4dp" android:background="@drawable/bg_tile"
    android:clickable="true" android:focusable="true" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">

    <TextView
        android:id="@+id/number"
        android:layout_width="56dp" android:layout_height="wrap_content"
        android:textColor="@color/accent" android:textSize="16sp" android:textStyle="bold" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:ellipsize="end" android:singleLine="true"
        android:textColor="@color/text" android:textSize="16sp" />

    <TextView
        android:id="@+id/copies"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:textColor="@color/muted" android:textSize="13sp" />
</LinearLayout>
